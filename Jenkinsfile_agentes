pipeline {
    agent none
stages {
        stage('Get Code') {
            agent { label 'principal' }
            steps {
                            sh 'whoami && hostname'
                            git branch: 'master', url: 'https://github.com/JulioEguis/todo-list-aws.git'
            }
        }

stage('Deploy') {
            agent { label 'principal' }
            steps {
                sh 'whoami && hostname'
                sh '''
                    sam build
                    sam deploy --config-file samconfig.toml --config-env production --no-fail-on-empty-changeset
                '''
            }
        }

stage('Rest Test') {
            agent { label 'agent-pruebas' }
            steps {
                sh 'whoami && hostname'
                script {
                    def BASE_URL = sh(
                        script: 'aws cloudformation describe-stacks --stack-name todo-list-aws-production --query "Stacks[0].Outputs[?OutputKey==\\`BaseUrlApi\\`].OutputValue" --region us-east-1 --output text',
                        returnStdout: true
                    ).trim()
                    withEnv(["BASE_URL=${BASE_URL}"]) {
                        sh '''
                            export PATH=/home/ubuntu/.local/bin:$PATH
                            python3 -m pytest -k "listtodos or gettodo" --junitxml=junit-report.xml test/integration/todoApiTest.py
                        '''
                    }
                }
                junit 'junit-report.xml'
            }
        }
    }
}


