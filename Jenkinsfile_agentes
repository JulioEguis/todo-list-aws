pipeline {
    agent none

stages {

    stage('Get Code') {
        agent { label 'principal' }
        steps {
        sh 'whoami'
                    sh 'hostname'
                    git branch: 'develop', url: 'https://github.com/JulioEguis/todo-list-aws.git'
            sh '''
            curl -o samconfig.toml https://raw.githubusercontent.com/JulioEguis/todo-list-aws-config/staging/samconfig.toml
            '''
    }
}

stage('Static Test') {
    agent { label 'agent-pruebas' }
    steps {
                        sh 'whoami'
                        sh 'hostname'
                        sh '''
                        export PATH=/home/ubuntu/.local/bin:$PATH
                        flake8 --exit-zero --format=pylint src > flake8.out
                        bandit --exit-zero -r src -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                '''
                                        recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')]
                                        recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')]
            }
        }

stage('Deploy') {
            agent { label 'principal' }
            steps {
                sh 'whoami'
                sh 'hostname'
                sh '''
                    sam build
                    sam validate --region us-east-1
                    sam deploy --config-file samconfig.toml --config-env staging --no-fail-on-empty-changeset
                '''
            }
        }

        stage('Rest Test') {
            agent { label 'agent-pruebas' }
            steps {
                sh 'whoami'
                sh 'hostname'
                script {
                    def BASE_URL = sh(
                        script: 'aws cloudformation describe-stacks --stack-name staging-todo-list-aws --query "Stacks[0].Outputs[?OutputKey==\\`BaseUrlApi\\`].OutputValue" --region us-east-1 --output text',
                        returnStdout: true
                    ).trim()

                    withEnv(["BASE_URL=${BASE_URL}"]) {
                        sh '''
                               export PATH=/home/ubuntu/.local/bin:$PATH 
                            python3 -m pytest --junitxml=junit-report.xml test/integration/todoApiTest.py -v
                        '''
                    }
                }
                junit 'junit-report.xml'
            }
        }

        stage('Promote') {
            agent { label 'principal' }
            steps {
                sh 'whoami'
                sh 'hostname'
                withCredentials([gitUsernamePassword(credentialsId: 'github-credentials', gitToolName: 'Default')]) {
                    sh '''
                        git fetch origin
                        git checkout master
                        git reset --hard origin/master
                        git merge -X ours develop --no-edit 
                        git push origin master
                    '''
                }
        }
 }
    }
 }
       
